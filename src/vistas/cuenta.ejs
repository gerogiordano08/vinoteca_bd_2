<%- include('partes/cabecera') %>
<section class="contenedor seccion">
  <h1 class="titulo-pagina">Configuración de cuenta</h1>
  <p class="bajada">Administrá tus datos personales y el acceso a tu cuenta.</p>
  <div class="cuenta">
    <%- include('partes/menu-cuenta') %>
    <div class="pasos">
      <form class="panel" action="/cuenta/datos" method="post">
        <h2 class="panel__titulo">Datos personales</h2>
        <div class="campos-2">
          <div class="campo"><label for="nombre">Nombre</label><input id="nombre" name="nombre" required autocomplete="given-name" value="<%= usuario.nombre %>"></div>
          <div class="campo"><label for="apellido">Apellido</label><input id="apellido" name="apellido" required autocomplete="family-name" value="<%= usuario.apellido %>"></div>
        </div>
        <div class="campo"><label for="email">Correo electrónico</label><input id="email" name="email" type="email" required autocomplete="email" value="<%= usuario.email %>"></div>
        <div class="campo"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" autocomplete="tel" placeholder="Ingresar teléfono" value="<%= usuario.telefono || '' %>"></div>
        <button class="boton boton--principal" type="submit">Guardar cambios</button>
      </form>

      <form class="panel" action="/cuenta/contrasena" method="post">
        <h2 class="panel__titulo">Cambiar contraseña</h2>
        <div class="campos-2">
          <div class="campo"><label for="actual">Contraseña actual</label><input id="actual" name="actual" type="password" required autocomplete="current-password"></div>
          <div class="campo"><label for="nueva">Nueva contraseña</label><input id="nueva" name="nueva" type="password" required minlength="8" autocomplete="new-password" placeholder="Nueva contraseña"></div>
        </div>
        <div class="campo"><label for="confirmacion">Confirmar nueva contraseña</label><input id="confirmacion" name="confirmacion" type="password" required minlength="8" autocomplete="new-password" placeholder="Repetir nueva contraseña"></div>
        <button class="boton boton--borde" type="submit">Actualizar contraseña</button>
      </form>
    </div>
  </div>
</section>
<%- include('partes/pie') %>
