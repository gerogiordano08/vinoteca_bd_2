<%- include('partes/cabecera') %>
<section class="contenedor seccion acceso">
  <%- include('partes/bienvenida') %>
  <form class="panel acceso__formulario" action="/cuenta/crear" method="post">
    <h1 class="titulo-pagina">Creá tu cuenta</h1>
    <p class="bajada">Completá tus datos para comenzar.</p>
    <div class="campos-2">
      <div class="campo"><label for="nombre">Nombre</label><input id="nombre" name="nombre" required autocomplete="given-name" placeholder="Tu nombre" value="<%= valores.nombre || '' %>"></div>
      <div class="campo"><label for="apellido">Apellido</label><input id="apellido" name="apellido" required autocomplete="family-name" placeholder="Tu apellido" value="<%= valores.apellido || '' %>"></div>
    </div>
    <div class="campo"><label for="email">Correo electrónico</label><input id="email" name="email" type="email" required autocomplete="email" placeholder="tu@email.com" value="<%= valores.email || '' %>"></div>
    <div class="campo"><label for="password">Contraseña</label><input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" placeholder="Crear contraseña"></div>
    <div class="campo"><label for="confirmacion">Confirmar contraseña</label><input id="confirmacion" name="confirmacion" type="password" required minlength="8" autocomplete="new-password" placeholder="Repetir contraseña"></div>
    <button class="boton boton--principal boton--ancho" type="submit">Crear cuenta</button>
    <a class="enlace" href="/cuenta/ingresar">Volver a iniciar sesión</a>
  </form>
</section>
<%- include('partes/pie') %>
