<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · vinoteca.</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Lora:wght@400;500&display=swap">
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
<header class="cabecera">
  <div class="cabecera__contenido">
    <a class="logo" href="/" aria-label="vinoteca, ir al inicio">vinoteca<span>.</span></a>
    <nav class="nav" aria-label="Principal">
      <a href="/catalogo" <%- rutaActual === '/catalogo' ? 'aria-current="page"' : '' %>>Catálogo</a>
      <a href="/catalogo?categoria=vinos">Vinos</a>
      <a href="/catalogo?categoria=espumantes">Espumantes</a>
      <a href="/catalogo?categoria=accesorios">Accesorios</a>
    </nav>
    <form class="buscador" action="/catalogo" method="get" role="search">
      <label class="oculto" for="buscar-cabecera">Buscar un producto</label>
      <input id="buscar-cabecera" type="search" name="texto" placeholder="Buscar un producto…" value="<%= busqueda %>">
    </form>
    <a class="boton boton--borde" href="<%= sesion ? '/cuenta' : '/cuenta/ingresar' %>"><%= sesion ? sesion.nombre : 'Ingresar' %></a>
    <a class="boton boton--principal" href="/carrito">Carrito (<%= carrito.cantidadArticulos %>)</a>
  </div>
</header>
<% if (mensaje) { %>
  <div class="contenedor"><p class="aviso aviso--<%= mensaje.tipo %>" role="status"><%= mensaje.texto %></p></div>
<% } %>
<main>
