{
  "name": "vinoteca-bd2",
  "version": "1.0.0",
  "description": "Vinoteca: e-commerce de vinos con Express y MongoDB (Diseño de Bases de Datos II, UM).",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/inicializar-base.js",
    "db:indices": "node scripts/actualizar-indices.js",
    "db:seed": "node scripts/cargar-datos.js",
    "db:paginas": "node scripts/cargar-usuarios-personalizados.js",
    "db:volumen": "node scripts/generar-productos.js",
    "db:volumen:copias": "node scripts/generar-productos.js",
    "db:volumen:compartidas": "node scripts/generar-productos-compartidos.js",
    "db:setup": "node scripts/inicializar-base.js && node scripts/cargar-datos.js",
    "consultas": "node scripts/consultas-avanzadas.js",
    "consulta": "node --env-file=.env consultas/ejecutar.js",
    "rendimiento": "node --env-file=.env scripts/medir-rendimiento.js",
    "backup": "node scripts/backup.js --exportar",
    "restaurar": "node scripts/restaurar.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "mongodb": "^7.7.0"
  }
}
